node_modules/
dist/
*.log
*.pem
.DS_Store

# Generated by scripts/copy-ranker.mjs from the vendor/search-ranker submodule, which
# is the one source of truth. Committing it would put a second copy of the ranker in
# this repo — the exact thing the submodule exists to prevent.
src/search-ranker.cjs

# Secrets — never commit (e.g. MCP_REGISTRY_KEY for the registry publish hook)
.env
.env.*
.mcpregistry_token

# Wrangler local dev state (miniflare cache/tmp) — never commit
.wrangler/

# Working notes, plans, checklists and submission drafts. This is a public repo:
# it carries the implementation, the docs its users need and what the runtime
# needs — not the scratch context of whoever was working on it.
#
# Two holes closed 2026-08-05, both found the hard way in the imqueue.com repo, where
# a plan reached master through them: these patterns were UPPERCASE only and gitignore
# is case-sensitive on Linux, so a lowercase `-plan.md` matched nothing; and a
# root-anchored name pattern does not reach a plan written into a NEW directory.
*-PLAN.md
*-NOTES.md
*-REPORT.md
*-HANDOVER.md
*-plan.md
*-notes.md
*-report.md
*-handover.md
notes/
plans/
DIRECTORY-SUBMISSION.md
